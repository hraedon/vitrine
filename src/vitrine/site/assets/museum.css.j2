/* vitrine — the statistical atlas (Plan 020)
   Light folio surfaces, hairline rules, tabular numerals. Color carries
   epistemology (tier chips, gap dashes) and editorial voice (petrol accent,
   ember copper) only. */
:root{color-scheme:light}
*{box-sizing:border-box}
body{margin:0;background:{{ T.GROUND }};color:{{ T.INK }};font-family:{{ T.SANS }};line-height:1.55;-webkit-font-smoothing:antialiased}
.wrap{max-width:1180px;margin:0 auto;padding:clamp(18px,4vw,44px)}
a{color:{{ T.BRASS }}}
a:hover{color:{{ T.BRASS_DEEP }}}
a:focus-visible,summary:focus-visible,.story-stop:focus-visible{outline:2px solid {{ T.BRASS_LIT }};outline-offset:3px;border-radius:2px}
.skip-link{position:fixed;top:10px;left:10px;z-index:200;transform:translateY(-160%);padding:8px 12px;background:{{ T.INK }};color:{{ T.CASE }};font:700 12px {{ T.MONO }};text-decoration:none;border-radius:3px}
.skip-link:focus{transform:none}
.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;border:0}

/* ── typographic voice ── */
.eyebrow{font-family:{{ T.MONO }};font-size:11.5px;letter-spacing:.22em;text-transform:uppercase;color:{{ T.BRASS }};margin:0 0 10px}
h1{font-family:{{ T.SERIF }};font-weight:600;text-wrap:balance;font-size:clamp(30px,4.6vw,48px);line-height:1.06;margin:0 0 8px;color:{{ T.INK }}}
h1 em{font-style:italic;color:{{ T.BRASS }}}
.sub{color:{{ T.INK_SOFT }};max-width:66ch;font-size:15.5px;margin:0}
h2.case-title{font-family:{{ T.MONO }};font-size:12px;letter-spacing:.2em;text-transform:uppercase;color:{{ T.BRASS }};margin:38px 0 6px;font-weight:600}
.case-sub{font-size:13.5px;color:{{ T.INK_SOFT }};margin:0 0 16px;max-width:76ch}

/* ── masthead ── */
.museum-header{display:grid;grid-template-columns:auto 1fr;gap:14px 34px;align-items:end;margin:0 0 clamp(30px,4.6vw,50px);padding-bottom:14px;border-bottom:3px double {{ T.EDGE }}}
.museum-brand{display:flex;flex-direction:column;align-items:flex-start;gap:1px;color:{{ T.INK }};text-decoration:none;white-space:nowrap}
.museum-brand b{font:600 24px {{ T.SERIF }};letter-spacing:.01em}
.museum-brand span{font:9px {{ T.MONO }};letter-spacing:.13em;text-transform:uppercase;color:{{ T.INK_SOFT }}}
.museum-map{display:flex;justify-content:flex-end;align-items:flex-end;gap:26px}
.nav-group{display:flex;gap:4px;align-items:center}
.nav-group-label{font:9px {{ T.MONO }};letter-spacing:.18em;text-transform:uppercase;color:{{ T.INK_SOFT }};margin-right:4px}
.museum-map a{position:relative;padding:5px 7px;color:{{ T.INK_SOFT }};font:10.5px {{ T.MONO }};letter-spacing:.1em;text-transform:uppercase;text-decoration:none;white-space:nowrap}
.museum-map a:hover{color:{{ T.INK }}}
.museum-map a.here{color:{{ T.BRASS }}}
.museum-map a.here::after{content:"";position:absolute;left:7px;right:7px;bottom:-16px;height:2px;background:{{ T.BRASS }}}

/* ── the disclaimer plaque + banners ── */
.plaque{margin:26px 0 22px;padding:16px 20px;border:1px solid {{ T.EDGE }};border-left:3px solid {{ T.BRASS }};background:{{ T.CASE }};border-radius:2px;max-width:80ch}
.plaque b{color:{{ T.INK }};font-family:{{ T.SERIF }};font-style:italic;font-weight:600}
.plaque span{color:{{ T.INK_SOFT }};font-size:14.5px}
.room-disclaimer{max-width:none}
.gap-banner{border:1px solid #d8b9a0;border-left:4px solid {{ T.COPPER }};background:#f5e8dd;padding:12px 15px;margin:14px 0 16px;color:#5d4026;font-size:14px;max-width:80ch}
.gap-banner b{color:{{ T.COPPER_DEEP }};font-family:{{ T.MONO }};font-size:10.5px;letter-spacing:.14em;text-transform:uppercase;margin-right:7px}
.caveat{border-left:3px solid {{ T.COPPER }};background:#f5ece2;padding:9px 12px;margin:8px 0;font-size:13px;color:#5d4026;max-width:76ch}

/* ── folio routes (index) ── */
.lobby-intro{display:grid;grid-template-columns:minmax(0,1.45fr) minmax(0,1fr);gap:clamp(24px,5vw,64px);align-items:start}
.lobby-intro h1{font-size:clamp(38px,5.3vw,62px);line-height:1.04;margin:16px 0 20px}
.lobby-intro .sub{font-size:16px;max-width:51ch;line-height:1.7}
.lobby-actions{display:flex;align-items:center;flex-wrap:wrap;gap:18px;margin-top:26px}
.lobby-actions a{font-size:14px;text-underline-offset:4px}
.entry-button{display:inline-flex;align-items:center;justify-content:space-between;gap:24px;padding:12px 18px;background:{{ T.BRASS }};color:{{ T.IVORY }};text-decoration:none;border:1px solid {{ T.BRASS }};border-radius:2px}
.entry-button:hover{background:{{ T.BRASS_DEEP }};color:{{ T.IVORY }}}
.lobby-guide{padding:24px;background:{{ T.CASE }};border:1px solid {{ T.EDGE }};border-top:3px solid {{ T.BRASS }}}
.lobby-guide .eyebrow{font-size:10px;letter-spacing:.12em}
.lobby-guide h2{font:600 27px/1.15 {{ T.SERIF }};margin:14px 0}
.lobby-guide p{font-size:14px;color:{{ T.INK_SOFT }}}
.lobby-guide>a{font-size:13px;text-underline-offset:4px}
.corpus-strip{display:grid;grid-template-columns:1fr 1fr;gap:16px;margin:22px 0 12px;padding-top:18px;border-top:1px solid {{ T.EDGE }}}
.corpus-strip div{display:flex;flex-direction:column-reverse;gap:2px}
.corpus-strip dt{font:10px {{ T.MONO }};color:{{ T.INK_SOFT }}}
.corpus-strip dd{font:600 29px {{ T.SERIF }};font-variant-numeric:tabular-nums;margin:0}
.lobby-guide .collection-note{font-size:12px;margin:12px 0}
.lobby-disclaimer{max-width:none;margin:30px 0 42px}
.wing-directory{scroll-margin-top:24px}
.directory-heading{display:grid;grid-template-columns:1fr 1fr;gap:24px;align-items:end;margin-bottom:20px}
.directory-heading h2{font:600 32px/1.1 {{ T.SERIF }};margin:0}
.directory-heading .eyebrow{font-size:10px;letter-spacing:.14em}
.directory-heading>p{font-size:14px;color:{{ T.INK_SOFT }};margin:0;max-width:48ch}
.wing-entry{padding:22px 24px;border:1px solid {{ T.EDGE }};background:{{ T.CASE }};margin-top:12px}
.wing-entry-heading{display:flex;align-items:center;gap:18px;margin-bottom:16px}
.wing-code{display:grid;place-items:center;width:48px;height:48px;border:1px solid {{ T.EDGE }};font:15px {{ T.MONO }};color:{{ T.BRASS }};flex:none}
.wing-entry h3{font:600 24px {{ T.SERIF }};margin:0}
.wing-entry p{font-size:12px;color:{{ T.INK_SOFT }};margin:3px 0 0}
.wing-decades{display:grid;grid-template-columns:repeat(auto-fit,minmax(92px,1fr));gap:8px}
.wing-decades a{display:flex;justify-content:space-between;align-items:center;gap:8px;min-height:44px;padding:9px 11px;border:1px solid {{ T.EDGE }};font:15px {{ T.SERIF }};color:{{ T.INK }};text-decoration:none}
.wing-decades a span{color:{{ T.BRASS }};font-family:{{ T.SANS }}}
.wing-decades a:hover{border-color:{{ T.BRASS }};background:{{ T.CASE_2 }};color:{{ T.BRASS }}}
.matrix-hint{font-size:12px;color:{{ T.INK_SOFT }}}
.matrix-wrap:focus-visible{outline:2px solid {{ T.BRASS_LIT }};outline-offset:3px}
.route-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:0;margin:18px 0 10px;border:1px solid {{ T.EDGE }};border-radius:3px;overflow:hidden;background:{{ T.CASE }}}
.route-card{display:flex;flex-direction:column;min-height:150px;padding:17px 18px;border-right:1px solid {{ T.EDGE }};text-decoration:none;color:inherit;background:{{ T.CASE }}}
.route-card:last-child{border-right:0}
.route-card:hover{background:{{ T.CASE_2 }}}
.route-no{font:10px {{ T.MONO }};letter-spacing:.16em;text-transform:uppercase;color:{{ T.BRASS }}}
.route-card h2{margin:14px 0 5px;font:600 21px/1.1 {{ T.SERIF }};color:{{ T.INK }}}
.route-card p{margin:0;color:{{ T.INK_SOFT }};font-size:13px;line-height:1.5}
.route-enter{margin-top:auto;padding-top:14px;font:10px {{ T.MONO }};letter-spacing:.13em;text-transform:uppercase;color:{{ T.BRASS }}}
/* the wing directory reuses the route cards; auto-fit so any wing count fills the row */
.route-grid.wing-grid{grid-template-columns:repeat(auto-fit,minmax(230px,1fr))}

/* ── the record at a glance (corpus matrix) ── */
.matrix-wrap{overflow-x:auto;border:1px solid {{ T.EDGE }};border-radius:3px;background:{{ T.CASE }};margin:10px 0 26px}
table.record-matrix{border-collapse:collapse;width:100%;min-width:760px}
.record-matrix th,.record-matrix td{border-bottom:1px solid {{ T.EDGE }};padding:9px 10px;text-align:left;vertical-align:middle}
.record-matrix thead th{font:600 10px {{ T.MONO }};letter-spacing:.12em;text-transform:uppercase;color:{{ T.BRASS }};border-bottom:2px solid {{ T.INK }};background:{{ T.CASE_2 }}}
.record-matrix th[scope="row"]{font:600 14px {{ T.SERIF }};white-space:nowrap}
.record-matrix th[scope="row"] a{color:{{ T.INK }};text-decoration:none}
.record-matrix th[scope="row"] a:hover{color:{{ T.BRASS }}}
.record-matrix tbody tr:hover td{background:{{ T.CASE_2 }}}
.record-matrix tfoot td{font:600 11px {{ T.MONO }};letter-spacing:.05em;border-bottom:0;border-top:2px solid {{ T.INK }};background:{{ T.CASE_2 }}}
.mx{display:block;text-decoration:none;color:inherit}
.mx .cnt{font:600 14px {{ T.SANS }};font-variant-numeric:tabular-nums;color:{{ T.INK }}}
.mx .comp{font:11px {{ T.MONO }};color:{{ T.INK_SOFT }}}
.mx.empty .cnt{color:{{ T.GAP }};font-weight:400}
.mix{display:flex;height:4px;margin:4px 0 3px;background:#e7decb;border-radius:2px;overflow:hidden}
.mix i{display:block;height:100%}
.mx-gap{font:10.5px {{ T.MONO }};color:{{ T.COPPER_DEEP }}}
.matrix-note{font-size:12.5px;color:{{ T.INK_SOFT }};margin:-16px 0 30px;max-width:78ch}

/* ── the shelf ruler (decade navigation) ── */
.room-map{margin:26px 0 18px;padding:12px 14px 9px;border:1px solid {{ T.EDGE }};border-radius:3px;background:{{ T.CASE }};overflow:hidden}
.room-map-context{display:grid;grid-template-columns:1fr auto 1fr;gap:12px;align-items:center;margin-bottom:10px;font:10px {{ T.MONO }};letter-spacing:.1em;text-transform:uppercase}
.room-map-context span{color:{{ T.INK_SOFT }};text-align:center}
.room-map-context a{text-decoration:none;color:{{ T.BRASS }};white-space:nowrap}
.room-map-context a:last-child{text-align:right}
.room-track{position:relative;display:grid;grid-template-columns:repeat(var(--room-count),minmax(52px,1fr));gap:0;list-style:none;margin:0;padding:0;overflow-x:auto;scrollbar-color:{{ T.BRASS_DIM }} {{ T.CASE }};scroll-snap-type:x proximity}
.room-track::before{content:"";position:absolute;top:8px;left:4%;right:4%;height:1px;background:{{ T.EDGE }}}
.room-track li{position:relative;z-index:1;text-align:center;scroll-snap-align:center}
.room-track a{display:flex;flex-direction:column;align-items:center;gap:5px;padding:2px 5px 4px;color:{{ T.INK_SOFT }};font:10px {{ T.MONO }};text-decoration:none}
.room-track i{width:13px;height:13px;border:3px solid {{ T.CASE }};border-radius:50%;background:{{ T.EDGE }};box-shadow:0 0 0 1px #c4b797}
.room-track a:hover{color:{{ T.INK }}}
.room-track a:hover i{background:{{ T.BRASS_DIM }}}
.room-track a.on{color:{{ T.BRASS }};font-weight:700}
.room-track a.on i{background:{{ T.BRASS }};box-shadow:0 0 0 2px {{ T.GROUND }},0 0 0 3px {{ T.BRASS }}}
.room-track.lobby{margin:12px 0 28px}
.decades{display:flex;gap:6px;align-items:center;flex-wrap:wrap;justify-content:center;margin:0 0 16px}
.decades .lab{font-family:{{ T.MONO }};font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:{{ T.INK_SOFT }};margin-right:4px}
.dbtn{font-family:{{ T.SERIF }};font-size:16px;color:{{ T.INK }};background:{{ T.CASE }};border:1px solid {{ T.EDGE }};padding:5px 11px;border-radius:2px;text-decoration:none;white-space:nowrap}
.dbtn:hover{border-color:{{ T.BRASS }};color:{{ T.BRASS }}}
.dbtn.on{background:{{ T.BRASS }};color:#fff;border-color:{{ T.BRASS }}}

/* ── the curator's route ── */
.room-overture{display:grid;grid-template-columns:minmax(250px,.72fr) minmax(0,1.6fr);gap:0;margin:24px 0 20px;border:1px solid {{ T.EDGE }};border-radius:3px;overflow:hidden;background:{{ T.CASE }}}
.story-label{display:flex;flex-direction:column;justify-content:space-between;min-height:230px;padding:20px;border-right:1px solid {{ T.EDGE }};background:{{ T.CASE_2 }}}
.story-label .story-kicker{margin:0;font:10px {{ T.MONO }};letter-spacing:.17em;text-transform:uppercase;color:{{ T.BRASS }}}
.story-label h2{margin:16px 0 8px;font:italic 600 clamp(24px,3vw,34px)/1.05 {{ T.SERIF }};color:{{ T.INK }}}
.story-label .story-question{margin:0;font:15.5px/1.45 {{ T.SERIF }};color:{{ T.BRASS_DEEP }}}
.story-label .story-note{margin:20px 0 0;padding-top:10px;border-top:1px solid {{ T.EDGE }};font:10px/1.5 {{ T.MONO }};letter-spacing:.05em;color:{{ T.INK_SOFT }}}
.story-trail{display:grid;grid-template-rows:repeat(4,1fr)}
/* an un-curated room has no trail: the overture collapses to one full-width
   label instead of leaving an empty case beside it */
.room-overture--uncurated{grid-template-columns:1fr}
.room-overture--uncurated .story-label{min-height:0;border-right:0}
.story-stop{position:relative;display:grid;grid-template-columns:auto 1fr auto;gap:4px 12px;align-items:baseline;padding:12px 16px;border-bottom:1px solid {{ T.EDGE }};text-decoration:none;color:inherit}
.story-stop:last-child{border-bottom:0}
.story-stop:hover{background:{{ T.GROUND }}}
.story-stop .stop-meta{font:9.5px {{ T.MONO }};letter-spacing:.11em;text-transform:uppercase;color:{{ T.BRASS }};white-space:nowrap}
.story-stop .stop-main{min-width:0}
.story-stop .stop-value{display:inline;font:600 16px/1.25 {{ T.SERIF }};color:{{ T.INK }}}
.story-stop .stop-label{display:block;margin-top:2px;font-size:12.5px;line-height:1.35;color:{{ T.INK_SOFT }}}
.story-stop .tchip{justify-self:end}

/* ── the stage ── */
.stage{position:relative;border:1px solid {{ T.EDGE }};border-radius:3px;background:{{ T.GROUND }};padding:8px}
.stagehint{font-family:{{ T.MONO }};font-size:10.5px;letter-spacing:.12em;text-transform:uppercase;color:{{ T.INK_SOFT }};text-align:center;padding:7px 0 2px}
svg.house{display:block;width:100%;height:auto}
.house .structure *{stroke:{{ T.BRASS_DIM }};fill:none;stroke-width:1.6;opacity:.62}
.house .groundline{stroke:{{ T.BRASS_DIM }};stroke-width:1.4;opacity:.4}
.house .zlabel{font-family:{{ T.MONO }};font-size:8.5px;letter-spacing:.1em;fill:{{ T.INK_SOFT }};text-transform:uppercase}
.house .znote{font-family:{{ T.MONO }};font-size:9px;letter-spacing:.06em;fill:{{ T.BRASS }};text-transform:uppercase}
.house a{text-decoration:none}
.hs .ring{fill:none;stroke:{{ T.BRASS_DIM }};stroke-width:1.4;opacity:.55}
.hs .gapring{stroke:{{ T.GAP }};stroke-dasharray:3 3;opacity:.9}
.hs .glyph{stroke:{{ T.BRASS }};fill:none;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}
.hs .glyph.fill{fill:{{ T.BRASS }};stroke:none}
.hs .pct{font-family:{{ T.MONO }};font-size:9px;fill:{{ T.BRASS }};text-anchor:middle;opacity:.9}
.hs .pct.gap{fill:{{ T.GAP }}}
.hs:hover .ring{stroke:{{ T.BRASS }};opacity:1}

/* ── the collection: panel ledgers ── */
.collection-head{display:grid;grid-template-columns:1fr auto;gap:14px;align-items:end;margin:40px 0 10px}
.collection-head h2{margin:0;font:600 27px {{ T.SERIF }};color:{{ T.INK }}}
.collection-head p{margin:3px 0 0;color:{{ T.INK_SOFT }};font-size:13px}
.collection-head span{font:10px {{ T.MONO }};letter-spacing:.12em;text-transform:uppercase;color:{{ T.BRASS }};white-space:nowrap}
.exhibit-map{position:sticky;top:0;z-index:30;display:grid;grid-template-columns:repeat(6,1fr);gap:1px;margin:0 0 8px;border:1px solid {{ T.EDGE }};border-radius:3px;background:{{ T.EDGE }};overflow:hidden;box-shadow:0 6px 16px -14px #7a6b4d}
.exhibit-map a{display:flex;flex-direction:column;gap:2px;padding:9px 10px;background:{{ T.CASE }};text-decoration:none;color:{{ T.INK_SOFT }};font:9px {{ T.MONO }};letter-spacing:.07em;text-transform:uppercase}
.exhibit-map a:hover{background:{{ T.CASE_2 }};color:{{ T.BRASS_DEEP }}}
.exhibit-map b{font:600 12px {{ T.SERIF }};letter-spacing:0;text-transform:none;color:{{ T.INK }}}
.exhibit-map span{color:{{ T.INK_SOFT }}}
.panel-group{margin:0 0 6px;scroll-margin-top:64px}
.panel-head{display:grid;grid-template-columns:1fr auto;gap:12px;align-items:baseline;margin:34px 0 2px;padding-bottom:7px;border-bottom:2px solid {{ T.INK }}}
.panel-head h3{margin:0;font:600 21px {{ T.SERIF }};color:{{ T.INK }}}
.panel-head span{font:10px {{ T.MONO }};letter-spacing:.12em;text-transform:uppercase;color:{{ T.INK_SOFT }};white-space:nowrap}

/* ── fact rows: provenance in the scan-line ── */
.fact-row{display:grid;grid-template-columns:minmax(150px,235px) minmax(0,1fr);gap:3px 20px;padding:15px 4px 14px;border-top:1px solid {{ T.EDGE }};scroll-margin-top:64px}
.fact-row:target{background:linear-gradient(90deg,#efe6cf,{{ T.CASE }} 70%);outline:1px solid {{ T.BRASS }};outline-offset:-1px}
.f-val{font:600 21px/1.15 {{ T.SERIF }};color:{{ T.INK }};font-variant-numeric:tabular-nums;overflow-wrap:anywhere}
.f-val .tchip{margin-left:8px}
.gap-row .f-val{font-style:italic;font-weight:400;font-size:16px;color:{{ T.GAP }}}
.f-body{min-width:0}
.f-lab{font-size:14.5px;color:{{ T.INK }};margin:0}
.f-unit{font-family:{{ T.MONO }};font-size:10.5px;color:{{ T.INK_SOFT }};margin:3px 0 9px;overflow-wrap:anywhere}
.f-ev{display:grid;grid-template-columns:minmax(0,1.5fr) minmax(0,1fr);gap:2px 16px}
.f-ev .mk{display:block;font:8.5px {{ T.MONO }};letter-spacing:.14em;text-transform:uppercase;color:{{ T.BRASS }};margin-bottom:1px}
.f-ev .ev{display:block;font-size:12.5px;line-height:1.45;color:#4b443b}
.f-open{justify-self:end;align-self:start;font:10px {{ T.MONO }};letter-spacing:.1em;text-transform:uppercase;text-decoration:none;border:1px solid {{ T.EDGE }};border-radius:2px;padding:3px 8px;color:{{ T.BRASS }};background:{{ T.CASE }}}
.f-open:hover{border-color:{{ T.BRASS }};color:{{ T.BRASS_DEEP }}}
.f-drawer{margin-top:9px}
.f-drawer summary{cursor:pointer;font:10px {{ T.MONO }};letter-spacing:.1em;text-transform:uppercase;color:{{ T.BRASS }};width:max-content}
.f-drawer[open] summary{margin-bottom:6px}
.drawer{font-size:12.5px;color:#4b4438;line-height:1.55;max-width:72ch}
.drawer a{color:{{ T.BRASS_DEEP }}}
.afford-box{margin:9px 0 3px;padding:9px 11px;background:{{ T.CASE_2 }};border-left:3px solid {{ T.BRASS }};border-radius:2px}
.afford-box .mk{font-family:{{ T.MONO }};font-size:9px;letter-spacing:.14em;text-transform:uppercase;color:{{ T.BRASS }};display:block;margin-bottom:3px}
.afford{font-family:{{ T.SERIF }};font-size:15px;color:#3d3a2c;margin:2px 0;font-variant-numeric:tabular-nums}
.afford-warning{font-size:11.5px;color:{{ T.COPPER_DEEP }};margin:6px 0 0;padding-top:6px;border-top:1px solid #ddd0b2;line-height:1.4}
.record-kind{display:inline-block;margin-left:9px;padding:2px 6px;font:8.5px {{ T.MONO }};letter-spacing:.1em;text-transform:uppercase;color:{{ T.INK_SOFT }};border:1px solid {{ T.EDGE }};border-radius:2px;background:{{ T.CASE }}}
.gap-row .record-kind{color:{{ T.COPPER_DEEP }};border-style:dashed}
.computed-row{background:linear-gradient(90deg,{{ T.CASE_2 }},transparent 55%)}

/* ── tier chips ── */
.tchip{font-family:{{ T.MONO }};font-size:10px;font-weight:700;color:#fff;border-radius:2px;padding:1px 5px;vertical-align:1px}

/* ── placard overlays (the spec record, deep-linked) ── */
.placard{background:linear-gradient(178deg,{{ T.IVORY }},{{ T.IVORY_2 }});color:{{ T.INK }};border-radius:4px;padding:18px 18px 16px;border:1px solid #c9bc9c;box-shadow:0 22px 50px -22px #5a4c2e;scroll-margin-top:20px}
.placard-overlay{display:none;position:fixed;inset:0;z-index:100;padding:5vh 10vw;overflow:auto;align-items:flex-start;justify-content:center}
.placard-overlay:target{display:flex}
.overlay-backdrop{position:fixed;inset:0;z-index:101;background:rgba(41,36,27,.55)}
.placard-overlay .placard-card{position:relative;z-index:102;max-height:88vh;overflow:auto;max-width:760px;width:auto;margin-top:0;padding-right:54px}
.overlay-close{position:absolute;top:8px;right:9px;z-index:103;font-size:25px;line-height:1;text-decoration:none;color:{{ T.BRASS_DEEP }};background:{{ T.IVORY_2 }};border:1px solid #c9bc9c;border-radius:3px;padding:2px 8px}
.overlay-close:hover{color:{{ T.BRASS_LIT }}}
.overlay-close:focus-visible{outline:3px solid {{ T.BRASS_LIT }};outline-offset:2px}
.placard-head{display:flex;justify-content:space-between;gap:12px;align-items:flex-start;margin-bottom:8px}
.placard .ceyebrow{font-family:{{ T.MONO }};font-size:10px;letter-spacing:.16em;text-transform:uppercase;color:{{ T.BRASS_DEEP }}}
.placard .record-kind{border-color:#c9bc9c;background:transparent}
.placard .cval{font-family:{{ T.SERIF }};font-size:21px;line-height:1.18;margin:7px 0 3px;color:{{ T.INK }};text-wrap:balance}
.placard .clab{font-size:13.5px;color:#57503e;margin:0 0 10px}
.placard .cunit{font-family:{{ T.MONO }};font-size:10.5px;color:#7a7159;margin:0 0 10px;overflow-wrap:anywhere;word-break:break-all}
.placard details{margin-top:10px}
.placard summary{cursor:pointer;font-family:{{ T.MONO }};font-size:10.5px;letter-spacing:.1em;text-transform:uppercase;color:{{ T.BRASS_DEEP }}}
.evidence-grid{display:grid;grid-template-columns:1.35fr 1fr;gap:1px;margin:12px 0;background:#cfc2a5;border:1px solid #cfc2a5;border-radius:3px;overflow:hidden}
.evidence-cell{padding:9px 10px;background:{{ T.IVORY_2 }}}
.evidence-cell .mk{display:block;margin-bottom:3px;font:9px {{ T.MONO }};letter-spacing:.13em;text-transform:uppercase;color:{{ T.BRASS_DEEP }}}
.evidence-cell .ev{display:block;font-size:11.5px;line-height:1.4;color:#454032}
.gap-placard .cval{font-style:italic;color:{{ T.GAP }}}

/* ── chart windows ── */
.chart-panel{border:1px solid {{ T.EDGE }};border-radius:3px;background:{{ T.CASE }};padding:14px 10px 6px;margin:10px 0 22px}
svg.arc,svg.comp,svg.meter{display:block;width:100%;height:auto}
svg.arc text,svg.comp text,svg.meter text{font-family:{{ T.MONO }}}
.grid{stroke:#e0d5b8;stroke-width:1}
.ylab{font-size:9.5px;fill:{{ T.INK_SOFT }};text-anchor:end}
.xlab{font-size:9.5px;fill:{{ T.INK_SOFT }};text-anchor:middle}
.unit{font-size:10px;fill:{{ T.INK_SOFT }};letter-spacing:.08em;text-transform:uppercase}
.vlab{font-size:10px;fill:{{ T.INK }};text-anchor:middle}
.tlet{font-size:9px;text-anchor:middle;font-weight:700}
.join{stroke-width:1.8;fill:none;opacity:.8}
.dot:hover{r:6}
.gapdot{fill:{{ T.CASE }};stroke:{{ T.GAP }};stroke-dasharray:3 3}
.gaplab{font-size:9px;fill:{{ T.GAP }};text-anchor:middle;font-style:italic}
.gaptrack{fill:none;stroke:{{ T.GAP }};stroke-dasharray:4 4;opacity:.75}
.seglab{font-size:10px;fill:#fff;text-anchor:middle;font-weight:700}
.caplab{font-size:10.5px;fill:{{ T.INK_SOFT }}}
.composition-key{border:1px solid {{ T.EDGE }};border-radius:3px;background:{{ T.CASE }};padding:10px 13px;margin:-10px 0 24px;max-width:100%}
.composition-key summary{cursor:pointer;font-family:{{ T.MONO }};font-size:10.5px;letter-spacing:.1em;text-transform:uppercase;color:{{ T.BRASS }};width:max-content;max-width:100%}
.composition-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(260px,1fr));gap:8px 14px;margin-top:10px}
.composition-decade{border-top:1px solid {{ T.EDGE }};padding-top:8px;font-size:12px;color:{{ T.INK_SOFT }}}
.composition-decade>a{font-family:{{ T.MONO }};font-weight:700;text-decoration:none;margin-right:6px}
.composition-decade b{color:#454032;font-weight:600}

/* ── corridors: plates and wings ── */
.atlas-directory{display:grid;grid-template-columns:repeat(2,1fr);gap:0;margin:26px 0 30px;border:1px solid {{ T.EDGE }};border-radius:3px;overflow:hidden;background:{{ T.CASE }}}
.atlas-card{display:grid;grid-template-columns:52px 1fr;gap:4px 14px;align-items:center;padding:15px 16px;border-right:1px solid {{ T.EDGE }};border-bottom:1px solid {{ T.EDGE }};color:inherit;text-decoration:none}
.atlas-card:nth-child(2n){border-right:0}
.atlas-card:nth-last-child(-n+2){border-bottom:0}
.atlas-card:hover{background:{{ T.CASE_2 }}}
.atlas-card .anum{grid-row:span 2;font:italic 27px {{ T.SERIF }};color:{{ T.BRASS }};text-align:center}
.atlas-card b{display:block;font:600 17.5px {{ T.SERIF }};color:{{ T.INK }}}
.atlas-card .aquest{display:block;margin-top:1px;font-size:12.5px;line-height:1.4;color:{{ T.INK_SOFT }}}
.atlas-card .acount{grid-column:2;font:9px {{ T.MONO }};letter-spacing:.09em;text-transform:uppercase;color:{{ T.INK_SOFT }}}
.atlas-key{display:grid;grid-template-columns:repeat(3,1fr);gap:1px;margin:0 0 46px;border:1px solid {{ T.EDGE }};background:{{ T.EDGE }};border-radius:3px;overflow:hidden}
.atlas-key div{padding:12px 14px;background:{{ T.CASE }};font-size:12px;color:{{ T.INK_SOFT }}}
.atlas-key b{display:block;margin-bottom:2px;font:10px {{ T.MONO }};letter-spacing:.12em;text-transform:uppercase;color:{{ T.BRASS }}}
.atlas-wing{scroll-margin-top:22px;margin:0 0 56px;padding-top:24px;border-top:1px solid {{ T.EDGE }}}
.wing-head{display:grid;grid-template-columns:64px minmax(0,1fr);gap:20px;align-items:start;margin-bottom:20px}
.wing-number{font:italic 46px/.9 {{ T.SERIF }};color:{{ T.BRASS }};text-align:center}
.wing-kicker{margin:0 0 5px;font:10px {{ T.MONO }};letter-spacing:.17em;text-transform:uppercase;color:{{ T.BRASS }}}
.wing-head h2{margin:0;font:600 clamp(26px,3.8vw,37px)/1.05 {{ T.SERIF }};color:{{ T.INK }}}
.wing-question{margin:5px 0 8px;font:italic 17.5px {{ T.SERIF }};color:{{ T.BRASS_DEEP }}}
.wing-intro{max-width:68ch;margin:0;color:{{ T.INK_SOFT }};font-size:14px}
.exhibit-stack{display:grid;min-width:0;gap:7px;margin-left:84px}
details.atlas-exhibit{min-width:0;max-width:100%;border:1px solid {{ T.EDGE }};border-radius:3px;background:{{ T.CASE }};overflow:clip}
details.atlas-exhibit[open]{background:{{ T.CASE }};border-color:#c4b48e;box-shadow:0 8px 22px -20px #7a6b4d}
.exhibit-summary{display:grid;grid-template-columns:26px minmax(0,1fr) auto;gap:11px;align-items:center;padding:13px 15px;cursor:pointer;list-style:none}
.exhibit-summary::-webkit-details-marker{display:none}
.exhibit-summary::before{content:"+";display:grid;place-items:center;width:22px;height:22px;border:1px solid {{ T.BRASS_DIM }};border-radius:50%;color:{{ T.BRASS }};font:15px/1 {{ T.MONO }}}
details[open]>.exhibit-summary::before{content:"–";background:{{ T.BRASS }};color:#fff;border-color:{{ T.BRASS }}}
.exhibit-title b{display:block;font:600 16.5px {{ T.SERIF }};color:{{ T.INK }}}
.exhibit-title span{display:block;margin-top:1px;font:10px {{ T.MONO }};letter-spacing:.05em;color:{{ T.INK_SOFT }}}
.coverage{font:9px {{ T.MONO }};letter-spacing:.1em;text-transform:uppercase;color:{{ T.BRASS }};text-align:right;white-space:nowrap}
.exhibit-body{min-width:0;padding:0 15px 15px 52px;border-top:1px solid #e2d8bf}
.exhibit-body .chart-panel{margin-bottom:10px}
.atlas-portal{display:grid;grid-template-columns:1fr auto;gap:20px;align-items:center;margin:0 0 10px;padding:17px 20px;border:1px solid #a8c0cb;border-left:4px solid {{ T.BRASS }};border-radius:3px;background:#eef4f6;text-decoration:none;color:inherit}
.atlas-portal b{display:block;font:600 19px {{ T.SERIF }};color:{{ T.INK }}}
.atlas-portal span span{display:block;margin-top:3px;color:{{ T.INK_SOFT }};font-size:13px}
.atlas-portal strong{font:10px {{ T.MONO }};letter-spacing:.12em;text-transform:uppercase;color:{{ T.BRASS }};white-space:nowrap}
.study-room{margin-top:64px;padding:22px;border:1px solid {{ T.EDGE }};border-radius:3px;background:{{ T.CASE }}}
.study-room h2{margin:0 0 5px;font:600 24px {{ T.SERIF }};color:{{ T.INK }}}
.study-room>p{margin:0 0 16px;color:{{ T.INK_SOFT }};font-size:13px;max-width:72ch}
.epoch-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-bottom:16px}
.epoch-card{padding:12px;border:1px solid {{ T.EDGE }};border-radius:2px;text-align:center;text-decoration:none;font:600 16px {{ T.SERIF }};color:{{ T.INK }};background:{{ T.CASE_2 }}}
.epoch-card:hover{border-color:{{ T.BRASS }};color:{{ T.BRASS }}}
.pair-archive summary{cursor:pointer;font:10px {{ T.MONO }};letter-spacing:.12em;text-transform:uppercase;color:{{ T.BRASS }};width:max-content}
.pairtable-wrap{box-sizing:border-box;width:100%;max-width:100%;overflow-x:auto;margin-top:10px}
.pairtable{font-size:13px;border-collapse:collapse;min-width:560px}
.pairtable td,.pairtable th{border:1px solid #e2d8bf;padding:4px 8px;text-align:center}
.pairtable a{text-decoration:none;font-family:{{ T.MONO }};font-size:11px}

/* ── pairwise record cards ── */
.pairgrid{display:grid;grid-template-columns:1fr 1fr;gap:10px;max-width:920px}
.valcard{border:1px solid {{ T.EDGE }};border-radius:3px;background:{{ T.CASE }};padding:13px 15px;text-decoration:none;display:block;color:inherit}
.valcard:hover{border-color:{{ T.BRASS }}}
.valcard .td{font-family:{{ T.MONO }};font-size:10px;letter-spacing:.1em;color:{{ T.INK_SOFT }};text-transform:uppercase}
.valcard .tv{font-family:{{ T.SERIF }};font-size:16.5px;color:{{ T.INK }};margin-top:3px;line-height:1.25}
.valcard .tv.gapv{font-size:13px;font-style:italic;color:{{ T.GAP }}}

/* ── walkthrough ── */
.people{display:grid;grid-template-columns:repeat(auto-fit,minmax(240px,1fr));gap:12px;margin:14px 0}
.person-card{border:1px solid {{ T.EDGE }};border-radius:3px;background:{{ T.CASE }};padding:13px 15px}
.person-card h5{font-family:{{ T.SERIF }};font-size:16px;margin:6px 0 8px;color:{{ T.INK }};font-weight:600}
.person-card svg{display:block;margin:0 auto}
.fig{fill:rgba(23,93,117,.07);stroke:{{ T.BRASS }};stroke-width:1.7;stroke-linejoin:round}
.fig.head{fill:rgba(23,93,117,.11)}
.prow{display:block;text-decoration:none;padding:6px 0;border-top:1px solid #e2d8bf;color:inherit}
.prow .sk{font-size:12px;color:{{ T.INK_SOFT }};display:block}
.prow .sv{font-family:{{ T.SERIF }};font-size:13.5px;color:{{ T.INK }}}
.houses{display:flex;gap:26px;align-items:flex-end;flex-wrap:wrap;margin:14px 0}
.houses figure{margin:0;text-align:center}
.houses figcaption{font-family:{{ T.MONO }};font-size:10px;letter-spacing:.08em;color:{{ T.INK_SOFT }};text-transform:uppercase;margin-top:6px}
.houses a{text-decoration:none}
.hline{stroke:{{ T.BRASS }};fill:none;stroke-width:1.7;stroke-linejoin:round}
.hline.gaph{stroke:{{ T.GAP }};stroke-dasharray:4 4}
.thesis{margin-top:14px;border:1px solid {{ T.EDGE }};border-radius:3px;background:{{ T.CASE }};padding:15px 17px}
.thesis h4{font-family:{{ T.MONO }};font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:{{ T.BRASS }};margin:0 0 3px;font-weight:600}
.thesis .tcap{font-size:12.5px;color:{{ T.INK_SOFT }};margin:0 0 13px}
.metric{margin:11px 0;padding-top:11px;border-top:1px solid #e2d8bf}
.metric:first-of-type{border-top:none;padding-top:0}
.metric .mlab{font-size:12.5px;color:#454032;margin-bottom:6px;display:flex;justify-content:space-between;align-items:baseline}
.metric .mlab em{font-style:normal;font-family:{{ T.MONO }};font-size:10px;color:{{ T.INK_SOFT }};letter-spacing:.05em}
.traj{display:grid;grid-template-columns:repeat(3,1fr);gap:8px}
.tnode{border:1px solid #e2d8bf;border-radius:3px;padding:7px 9px 8px;background:{{ T.CASE_2 }};display:block;text-decoration:none;color:inherit}
.tnode:hover{border-color:{{ T.BRASS }}}
.tnode .td{font-family:{{ T.MONO }};font-size:9.5px;letter-spacing:.08em;color:{{ T.INK_SOFT }};text-transform:uppercase}
.tnode .tv{font-family:{{ T.SERIF }};font-size:16px;color:{{ T.INK }};line-height:1.15;margin-top:2px;font-variant-numeric:tabular-nums}
.tnode .tv.gapv{font-family:{{ T.SANS }};font-size:12px;font-style:italic;color:{{ T.GAP }}}
.tbar{height:5px;border-radius:3px;background:#e0d5b8;margin-top:7px;overflow:hidden}
.tbar i{display:block;height:100%;background:{{ T.BRASS }};border-radius:3px}
.tbar.fall i{background:{{ T.COPPER }}}
.flag{font-family:{{ T.MONO }};font-size:8.5px;letter-spacing:.04em;padding:0 4px;border-radius:2px}
.flag.gapf{background:rgba(110,106,94,.14);color:{{ T.INK_SOFT }};border:1px solid #c4bcab}
.flag.tier{color:#fff}

/* ── ledgers (methodology / bibliography) ── */
.ledger{border-top:2px solid {{ T.INK }};margin-top:20px}
.ledger-row{display:grid;grid-template-columns:46px minmax(0,1fr);gap:4px 16px;padding:14px 4px;border-bottom:1px solid {{ T.EDGE }};scroll-margin-top:20px}
.ledger-row:target{background:linear-gradient(90deg,#efe6cf,transparent 70%)}
.ledger-row .l-num{font:italic 17px {{ T.SERIF }};color:{{ T.BRASS_DIM }};text-align:right}
.ledger-row .l-title{font:600 16.5px {{ T.SERIF }};color:{{ T.INK }}}
.ledger-row .l-meta{font:10px {{ T.MONO }};letter-spacing:.1em;text-transform:uppercase;color:{{ T.BRASS }};margin-top:2px}
.ledger-row .l-body{font-size:13.5px;color:#454032;margin-top:6px;line-height:1.55;max-width:78ch}
.ledger-row .l-body a{overflow-wrap:anywhere}
.ledger-row details{margin-top:8px}
.ledger-row summary{cursor:pointer;font:10px {{ T.MONO }};letter-spacing:.1em;text-transform:uppercase;color:{{ T.BRASS }}}

/* ── the docent layer (essays) ── */
.docent-sheet{max-width:76ch;margin:26px 0 10px}
.docent-card{border-left:2px solid {{ T.BRASS }};padding:2px 0 2px 20px;margin:0 0 22px;font-family:{{ T.SERIF }};font-size:17px;line-height:1.62;color:{{ T.INK }}}
.docent-card p{margin:0 0 13px}
.docent-card p:last-child{margin-bottom:0}
.factchip{display:inline-block;text-decoration:none;color:{{ T.INK }};border-bottom:1px dotted {{ T.BRASS_DIM }}}
.factchip:hover{border-bottom-color:{{ T.BRASS }};color:{{ T.BRASS_DEEP }}}
.factchip .factchip-val{font-family:{{ T.SERIF }};font-weight:600;color:{{ T.BRASS_DEEP }};white-space:nowrap;font-variant-numeric:tabular-nums}
.factchip .tchip{margin-left:4px}
.factchip .record-kind{margin-left:5px;padding:0 4px}
.docent-chart{margin:0 0 26px}
.docent-chart figcaption{font:600 15px {{ T.SERIF }};color:{{ T.INK }};margin-bottom:6px}
.docent-chart figcaption b{font-weight:600}
.docent-rooms{margin-top:8px;border-top:1px solid {{ T.EDGE }};padding-top:12px}
.docent-crosslink{margin:4px 0 0}
.essay-row{text-decoration:none;color:inherit}
.essay-row:hover .l-title{color:{{ T.BRASS_DEEP }}}

/* ── legends ── */
.legends{display:grid;grid-template-columns:1fr;gap:14px;margin-top:30px}
@media(min-width:680px){.legends{grid-template-columns:1fr 1fr}}
.leg{border:1px solid {{ T.EDGE }};border-radius:3px;padding:15px 17px;background:{{ T.CASE }}}
.leg h4{font-family:{{ T.MONO }};font-size:11px;letter-spacing:.16em;text-transform:uppercase;color:{{ T.BRASS }};margin:0 0 11px;font-weight:600}
.tierrow{display:flex;align-items:center;gap:10px;margin:7px 0;font-size:13px}
.tierrow .swatch{width:13px;height:13px;border-radius:2px;flex:none}
.leg p{font-size:13px;color:{{ T.INK_SOFT }};margin:6px 0 0}
.leg p b{color:{{ T.INK }}}

footer.colophon{margin-top:36px;padding-top:14px;border-top:3px double {{ T.EDGE }};font-size:12.5px;color:{{ T.INK_SOFT }};max-width:84ch}
footer.colophon b{color:{{ T.INK }}}
.case-sub.gapv{font-style:italic;color:{{ T.GAP }}}
.recessions-credit{margin-top:28px;border-top:1px solid {{ T.EDGE }};padding-top:12px;max-width:80ch;overflow-wrap:break-word;word-break:normal}

/* ── responsive ── */
@media(max-width:860px){
  .lobby-intro{grid-template-columns:1fr}
  .lobby-guide h2 br{display:none}
  .corpus-strip{grid-template-columns:repeat(4,1fr)}
  .museum-header{grid-template-columns:1fr;align-items:start;margin-bottom:34px}
  .museum-map{justify-content:flex-start;flex-wrap:wrap;gap:10px 20px}
  .museum-map a.here::after{bottom:-4px}
  .route-grid{grid-template-columns:1fr}
  .route-card{min-height:0;border-right:0;border-bottom:1px solid {{ T.EDGE }}}
  .route-card:last-child{border-bottom:0}
  .atlas-directory{grid-template-columns:1fr}
  .atlas-card{border-right:0}
  .atlas-card:nth-last-child(-n+2){border-bottom:1px solid {{ T.EDGE }}}
  .atlas-card:last-child{border-bottom:0}
  .atlas-key{grid-template-columns:1fr}
  .exhibit-stack{margin-left:0}
  .wing-head{grid-template-columns:52px minmax(0,1fr);gap:12px}
  .wing-number{font-size:38px}
  .room-overture{grid-template-columns:1fr}
  .story-label{min-height:0;border-right:0;border-bottom:1px solid {{ T.EDGE }}}
  .exhibit-map{grid-template-columns:repeat(3,1fr)}
  .panel-group,.fact-row{scroll-margin-top:104px}
}
@media(max-width:560px){
  .directory-heading{grid-template-columns:1fr;gap:12px}
  .corpus-strip{grid-template-columns:1fr 1fr}
  .lobby-guide,.wing-entry{padding:18px}
  .wrap{padding-left:16px;padding-right:16px}
  .museum-brand span,.nav-group-label{display:none}
  .museum-map{display:grid;grid-template-columns:1fr;gap:5px}
  .nav-group{flex-wrap:wrap;padding-bottom:4px}
  .museum-map a{padding-left:4px;padding-right:4px}
  .museum-map a.here::after{left:4px;right:4px}
  .room-map{margin-left:-16px;margin-right:-16px;border-left:0;border-right:0;border-radius:0;padding-left:10px;padding-right:10px}
  .room-map-context{grid-template-columns:1fr 1fr}
  .room-map-context span{grid-column:1/-1;grid-row:1}
  .story-stop{grid-template-columns:1fr auto}
  .story-stop .stop-meta{grid-column:1/-1}
  .collection-head{grid-template-columns:1fr}
  .exhibit-map{display:flex;overflow-x:auto;scroll-snap-type:x proximity;border-left:0;border-right:0;border-radius:0;margin-left:-16px;margin-right:-16px}
  .exhibit-map a{min-width:128px;scroll-snap-align:start}
  .fact-row{grid-template-columns:1fr}
  .f-open{justify-self:start;margin-top:4px}
  .f-ev{grid-template-columns:1fr}
  .evidence-grid{grid-template-columns:1fr}
  .pairgrid{grid-template-columns:1fr}
  .epoch-grid{grid-template-columns:1fr}
  .atlas-portal{grid-template-columns:1fr}
  .exhibit-summary{grid-template-columns:24px minmax(0,1fr)}
  .coverage{grid-column:2;text-align:left}
  .exhibit-body{padding-left:12px;padding-right:12px}
  .placard-overlay{padding:3vh 4vw}
  .ledger-row{grid-template-columns:1fr}
  .ledger-row .l-num{text-align:left}
  .stage,.chart-panel{box-sizing:border-box;width:100%;max-width:100%;overflow-x:auto;overscroll-behavior-inline:contain}
  .stage svg.house{width:720px;max-width:none}
  .chart-panel svg.arc,.chart-panel svg.comp,.chart-panel svg.meter{width:700px;max-width:none}
}
@media(prefers-reduced-motion:reduce){*{transition:none !important;scroll-behavior:auto !important}}

/* Labelled objects keep source meaning visible at every viewport width. */
.collection-intro{padding:28px 32px;margin:26px 0;background:{{ T.CASE }};border-left:3px solid {{ T.BRASS }}}
.collection-intro h2{font-family:{{ T.SERIF }};font-weight:400;margin:8px 0 14px;font-size:clamp(26px,3vw,38px)}
.collection-intro p{max-width:76ch;line-height:1.7}
.artifact-collection{margin:34px 0}
.artifact-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:12px}
.artifact-card{display:flex;gap:16px;align-items:center;padding:20px 16px;background:{{ T.CASE }};border:1px solid {{ T.EDGE }};border-radius:4px;text-decoration:none;color:inherit;min-width:0;transition:background .15s,border-color .15s}
.artifact-card:hover,.artifact-card:focus-visible{border-color:{{ T.BRASS }};background:{{ T.GROUND }}}
.artifact-image{display:grid;place-items:center;flex:0 0 72px;height:84px;background:linear-gradient(145deg,#dce9df,#eee6cd);border-radius:40px 40px 8px 8px}
.artifact-card:nth-child(3n+2) .artifact-image{background:linear-gradient(145deg,#e9dccd,#f1e9d5)}
.artifact-card:nth-child(3n) .artifact-image{background:linear-gradient(145deg,#dce5e8,#ece6d5)}
.artifact-icon{width:58px;height:58px;overflow:visible}
.artifact-icon .glyph{stroke:{{ T.BRASS }};fill:none;stroke-width:1.25;stroke-linecap:round;stroke-linejoin:round}
.artifact-icon .glyph.shade,.hs .glyph.shade{fill:{{ T.BRASS }};fill-opacity:.09}
.artifact-icon .glyph.fill{fill:{{ T.BRASS }};stroke:none}
.artifact-icon .glyph.detail,.hs .glyph.detail{stroke-width:.9;opacity:.7}
.artifact-caption{min-width:0;display:grid;gap:7px}
.artifact-caption b{font-size:14px;line-height:1.45;font-weight:500}
.artifact-caption>span{font-family:{{ T.SERIF }};font-size:20px;line-height:1.3;overflow-wrap:anywhere}
.artifact-caption small{font-size:10px;color:{{ T.BRASS }}}
.artifact-notes{display:flex;flex-wrap:wrap;gap:12px;margin-top:15px;font-size:13px}
.room-schematic{margin:22px 0;border-block:1px solid {{ T.EDGE }};padding:16px 0}
.room-schematic>summary{cursor:pointer;color:{{ T.BRASS }}}
@media(max-width:1000px){.artifact-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:560px){.artifact-grid{grid-template-columns:1fr}.artifact-card{padding:14px 16px}.collection-intro{padding:20px}.artifact-image{height:72px}.artifact-caption>span{font-size:20px}}

.source-records{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
.source-record{background:{{ T.CASE }};border:1px solid {{ T.EDGE }};padding:20px;min-width:0}
.source-record p{line-height:1.65;overflow-wrap:anywhere}
.source-record small,.audit-summary{color:{{ T.INK_SOFT }};line-height:1.7}
.source-room{margin:30px 0}
@media(max-width:640px){.source-records{grid-template-columns:1fr}}
